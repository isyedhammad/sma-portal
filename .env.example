# ==============================================================
# Directorate General of Mines & Minerals, Government of the Punjab
# SMA Licensing & Quasi-Judicial Hearing Management System
# Cloud Database Configuration (.env)
# ==============================================================

# Option 1: Supabase Cloud Database (Recommended)
# Create a free project at https://supabase.com
# Execute the SQL schema from SUPABASE_SQL_SCHEMA in your Supabase SQL Editor
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# Option 2: Firebase Firestore
# Create a project at https://console.firebase.google.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
